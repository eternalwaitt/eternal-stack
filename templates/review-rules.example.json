{
  "schemaVersion": 1,
  "rulesetId": "repository-review",
  "version": 1,
  "enabledRuleIds": [],
  "rules": [
    {
      "ruleId": "no-expect-any",
      "engine": "ast_grep",
      "scopeGlobs": [
        "src/**/*.ts"
      ],
      "lensId": "types_schema_contracts",
      "findingKind": "maintainability",
      "category": "unsafe-type-escape",
      "rationaleHash": "a7cbab0879c654ca910c328e5e5c0552fb49ba281cfacbe4466c44b360d3f7e6",
      "sourcePrCount": 3,
      "severity": "medium",
      "ownerRole": "repository-owner",
      "version": 1,
      "rollback": {
        "disableRuleId": "no-expect-any"
      },
      "astGrep": {
        "language": "typescript",
        "pattern": "$VALUE as any",
        "inside": null,
        "not": []
      },
      "literal": null
    },
    {
      "ruleId": "no-expect-any-tsx",
      "engine": "ast_grep",
      "scopeGlobs": [
        "src/**/*.tsx"
      ],
      "lensId": "types_schema_contracts",
      "findingKind": "maintainability",
      "category": "unsafe-type-escape",
      "rationaleHash": "a7cbab0879c654ca910c328e5e5c0552fb49ba281cfacbe4466c44b360d3f7e6",
      "sourcePrCount": 3,
      "severity": "medium",
      "ownerRole": "repository-owner",
      "version": 1,
      "rollback": {
        "disableRuleId": "no-expect-any-tsx"
      },
      "astGrep": {
        "language": "tsx",
        "pattern": "$VALUE as any",
        "inside": null,
        "not": []
      },
      "literal": null
    },
    {
      "ruleId": "no-focused-tests",
      "engine": "regex",
      "scopeGlobs": [
        "**/*.test.js",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.mjs",
        "**/*.test.cjs",
        "**/*.spec.js",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.spec.mjs",
        "**/*.spec.cjs"
      ],
      "lensId": "test_delta",
      "findingKind": "test",
      "category": "focused-test",
      "rationaleHash": "80548f2ec5356e9a30d4bc209970ecf17661d27e42a6d04ec25b602414717f1c",
      "sourcePrCount": 3,
      "severity": "high",
      "ownerRole": "repository-owner",
      "version": 1,
      "rollback": {
        "disableRuleId": "no-focused-tests"
      },
      "astGrep": null,
      "literal": null,
      "regex": {
        "pattern": "\\.\\s*only\\s*\\(",
        "flags": ""
      }
    },
    {
      "ruleId": "no-skipped-test",
      "engine": "regex",
      "scopeGlobs": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.js",
        "**/*.test.mjs",
        "**/*.test.cjs",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.spec.js",
        "**/*.spec.mjs",
        "**/*.spec.cjs"
      ],
      "lensId": "test_delta",
      "findingKind": "test",
      "category": "skipped-test",
      "rationaleHash": "f62e35f87117817df020fc539b0cd2a272e6b792c07aa4dadf4eeff4c4d77b5e",
      "sourcePrCount": 3,
      "severity": "high",
      "ownerRole": "repository-owner",
      "version": 2,
      "rollback": {
        "disableRuleId": "no-skipped-test"
      },
      "astGrep": null,
      "literal": null,
      "regex": {
        "pattern": "(?:\\b(?:describe|it|test)\\s*\\.\\s*skip(?:\\s*\\.\\s*each)?|\\b(?:xit|xdescribe|xtest))\\s*\\(",
        "flags": ""
      }
    },
    {
      "ruleId": "no-empty-catch",
      "engine": "regex",
      "scopeGlobs": [
        "src/**/*.ts",
        "src/**/*.tsx",
        "apps/**/*.ts",
        "apps/**/*.tsx",
        "packages/**/*.ts",
        "packages/**/*.tsx"
      ],
      "lensId": "correctness_state",
      "findingKind": "bug",
      "category": "silent-fallback",
      "rationaleHash": "25518f03204581c0870d589281786dd9f3afb064748029efad24afe109a82486",
      "sourcePrCount": 3,
      "severity": "high",
      "ownerRole": "repository-owner",
      "version": 2,
      "rollback": {
        "disableRuleId": "no-empty-catch"
      },
      "astGrep": null,
      "literal": null,
      "regex": {
        "pattern": "catch\\s*(?:\\([^)]*\\))?\\s*\\{\\s*\\}",
        "flags": ""
      }
    },
    {
      "ruleId": "nextjs-no-redirect-in-try-catch",
      "engine": "regex",
      "scopeGlobs": [
        "app/**/*.ts",
        "app/**/*.tsx",
        "src/**/*.ts",
        "src/**/*.tsx",
        "apps/**/*.ts",
        "apps/**/*.tsx"
      ],
      "lensId": "correctness_state",
      "findingKind": "bug",
      "category": "nextjs-redirect-swallowed",
      "rationaleHash": "81d3cf1dc5a564bec431c9601dbea6a95a037596e5d16ad32841635a3c128d75",
      "sourcePrCount": 3,
      "severity": "high",
      "ownerRole": "repository-owner",
      "version": 2,
      "rollback": {
        "disableRuleId": "nextjs-no-redirect-in-try-catch"
      },
      "astGrep": null,
      "literal": null,
      "regex": {
        "pattern": "try\\s*\\{(?:[^{}]|\\{[^{}]*\\})*\\{?[^{}]*\\b(?:redirect|notFound)\\s*\\(",
        "flags": ""
      }
    }
  ]
}
