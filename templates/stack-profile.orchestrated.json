{
  "schemaVersion": 1,
  "profile": "orchestrated",
  "description": "Opt-in ETRNL orchestration harness without global semantic memory or backlog services.",
  "installCommand": "./scripts/install.sh --profile orchestrated",
  "components": {
    "etrnl": {
      "enabled": true,
      "authority": "compact-handoff",
      "installs": [
        "claude-hooks",
        "claude-skills",
        "claude-agents",
        "claude-commands",
        "codex-skills",
        "rules",
        "scripts",
        "settings-audit"
      ],
      "requiredHooks": [
        "cc-sessionstart-restore.sh",
        "cc-precompact-save.sh",
        "cc-postcompact-record.sh",
        "cc-stop-verifier.sh"
      ],
      "requiredHooksIntent": "compact-handoff and stop-gate minimum; templates/settings.strict.json owns the broader lifecycle hook set",
      "healthChecks": [
        "tests/test-hooks.sh",
        "tests/test-workflow-tools.sh",
        "scripts/doctor.sh"
      ]
    },
    "hindsight": {
      "enabled": false,
      "reason": "orchestrated profile does not install third-party memory plugins"
    },
    "beads": {
      "enabled": false,
      "reason": "orchestrated profile does not install backlog databases"
    },
    "codegraph": {
      "enabled": false,
      "reason": "orchestrated profile does not install global code navigation tools"
    }
  },
  "settings": {
    "template": "templates/settings.strict.json",
    "stockBoundary": "repo-owned harness hooks only",
    "unsupportedTopLevelKeys": [
      "autoCompactWindow",
      "skipAutoPermissionPrompt"
    ]
  },
  "rollback": {
    "installMetadataTarget": "~/.claude/etrnl/install.json",
    "required": true
  },
  "nativeAdapters": {
    "schemaVersion": 1,
    "defaultEnabled": false,
    "enableFlag": "--native-continuity",
    "registration": "scripts/native-adapters.mjs",
    "hosts": {
      "claude": {
        "minimumVersion": "2.1.296",
        "config": "settings.json"
      },
      "codex": {
        "minimumVersion": "0.159.2",
        "config": "hooks.json"
      }
    },
    "runtimeVerification": "separate-host-callback-proof"
  }
}
